# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# packaged source archives (produced by package-pack.sh)
*.zip

# local planning/spec docs
seo_spec.md
SEO_PLAN.md
SEO_TODO.md
seo-keywords-report.csv
seo-keywords-report.md

# AI / tool configs (local-only, never commit)
.claude/
.agents/
.codegraph/
.playwright-mcp/
skills-lock.json
CLAUDE-FABLE-5.md
CLAUDE.md
AGENTS.md

# dev screenshots (root-level PNGs are temp debugging assets)
/*.png

# local workspace data (memory notes, GSC/GA4 extracts, Chrome login profile
# with cookies — never commit any of it)
.workbuddy/

# growth ops docs (internal strategy, triage, receipts — not site content)
GROWTH_PLAN_90D.md
INDEXING_TRIAGE.md
A1_REQUEST_INDEXING_RECEIPTS.md

# one-off browser automation scripts (hardcoded local paths, depend on the
# local Chrome login profile; lint already ignores scripts/**)
scripts/*.cjs
